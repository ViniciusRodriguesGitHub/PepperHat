rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public data used by multiple apps (including Kanban public mode).
    match /artifacts/{appId}/public/data/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /artifacts/{appId}/public/data/{publicCollection}/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && publicCollection != 'consenso_lookup';
    }

    // Consenso lookup kept explicit for compatibility with existing payload shape.
    match /artifacts/{appId}/public/data/consenso_lookup/{eventId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['ownerUid', 'updatedAt'])
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    match /artifacts/{appId}/users/{ownerUid}/consenso_v1/{eventId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == ownerUid;

      function validRequiredAnswers() {
        let config = get(/databases/$(database)/documents/artifacts/$(appId)/users/$(ownerUid)/consenso_v1/$(eventId)).data.config;
        let labels = config.get('requiredInfoLabels', []);
        let answers = request.resource.data.get('requiredInfoAnswers', []);
        return labels is list && labels.size() <= 4 && answers is list && answers.size() <= 4
          && (!('requiredInfoLabels' in config) || answers.size() == labels.size())
          && (answers.size() < 1 || (answers[0] is string && answers[0].size() <= 300 && answers[0].matches('.*[^\\s].*')))
          && (answers.size() < 2 || (answers[1] is string && answers[1].size() <= 300 && answers[1].matches('.*[^\\s].*')))
          && (answers.size() < 3 || (answers[2] is string && answers[2].size() <= 300 && answers[2].matches('.*[^\\s].*')))
          && (answers.size() < 4 || (answers[3] is string && answers[3].size() <= 300 && answers[3].matches('.*[^\\s].*')));
      }

      match /votes/{voteUid} {
        allow read: if request.auth != null && (
          request.auth.uid == ownerUid || request.auth.uid == voteUid
        );
        allow create, update: if request.auth != null
          && request.auth.uid == voteUid
          && get(/databases/$(database)/documents/artifacts/$(appId)/users/$(ownerUid)/consenso_v1/$(eventId)).data.config.get('votingOpened', true) == true
          && get(/databases/$(database)/documents/artifacts/$(appId)/users/$(ownerUid)/consenso_v1/$(eventId)).data.config.get('finalized', false) == false
          && !request.resource.data.timeSlots.hasAny(get(/databases/$(database)/documents/artifacts/$(appId)/users/$(ownerUid)/consenso_v1/$(eventId)).data.config.get('blockedSlots', []))
          && request.resource.data.userId == voteUid
          && request.resource.data.keys().hasOnly(['userId', 'userName', 'timeSlots', 'preferredSlots', 'comment', 'commentVisibility', 'votedAt', 'requiredInfo', 'requiredInfoAnswers'])
          && validRequiredAnswers()
          && request.resource.data.get('requiredInfo', '') is string
          && request.resource.data.get('requiredInfo', '').size() <= 300
          && (get(/databases/$(database)/documents/artifacts/$(appId)/users/$(ownerUid)/consenso_v1/$(eventId)).data.config.get('requiredInfoLabel', '') == ''
            || request.resource.data.get('requiredInfo', '').matches('.*[^\\s].*'))
          && request.resource.data.userName is string
          && request.resource.data.userName.size() <= 120
          && request.resource.data.timeSlots is list
          && request.resource.data.preferredSlots is list
          && request.resource.data.timeSlots.hasAll(request.resource.data.preferredSlots)
          && request.resource.data.comment is string
          && request.resource.data.comment.size() <= 1000
          && request.resource.data.commentVisibility in ['organizer', 'everyone'];
        allow delete: if request.auth != null && request.auth.uid == ownerUid;
      }

      // Recibos de participação alimentam apenas o contador e nunca contêm horários.
      match /participants/{participantUid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && (request.auth.uid == participantUid || request.auth.uid == ownerUid)
          && request.resource.data.userId == participantUid
          && request.resource.data.keys().hasOnly(['userId', 'votedAt']);
        allow delete: if request.auth != null
          && (request.auth.uid == participantUid || request.auth.uid == ownerUid);
      }

      match /public_comments/{commentUid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && request.auth.uid == commentUid
          && request.resource.data.userId == commentUid
          && request.resource.data.keys().hasOnly(['userId', 'userName', 'comment', 'votedAt'])
          && request.resource.data.userName is string
          && request.resource.data.userName.size() <= 120
          && request.resource.data.comment is string
          && request.resource.data.comment.size() > 0
          && request.resource.data.comment.size() <= 1000;
        allow delete: if request.auth != null
          && (request.auth.uid == commentUid || request.auth.uid == ownerUid);
      }
    }

    // Generic private user workspace (Kanban and other tools).
    match /artifacts/{appId}/users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
